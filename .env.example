# Copy to .env (gitignored) and fill in. Never put real values in this file.
# Real environment variables override anything set here.

# --- Data -------------------------------------------------------------------
# Platform Postgres (Neon). Use a read-only role; this repo only reads.
DATABASE_URL=

# --- AWS / SageMaker ----------------------------------------------------------
# Credentials come from the Studio execution role; no AWS keys needed here.
DMI_S3_BUCKET=deep-member-insights-fine-tuning-bucket
DMI_S3_PREFIX=dmi
# Optional: role for training jobs. Defaults to the Studio execution role.
SAGEMAKER_ROLE_ARN=

# --- Hugging Face ---------------------------------------------------------------
# Only needed for gated models (the llama-3.1-8b baseline; Gemma 4 is not gated).
# Passed to training jobs as an env var.
HF_TOKEN=

# --- Modal inference endpoint --------------------------------------------------
# OpenAI-compatible base URL of the deployed server, ending in /v1
DMI_INFERENCE_URL=
# Modal proxy token as "<token-id>.<token-secret>" (create with
# `modal workspace proxy-tokens`); sent as `Authorization: Bearer ...`.
# The platform needs the same value.
DMI_INFERENCE_API_KEY=

# --- Evals ------------------------------------------------------------------------
# Optional LLM judge for free-text fields (profileSummary, etc.)
OPENAI_API_KEY=
DMI_JUDGE_MODEL=gpt-5.4-mini
